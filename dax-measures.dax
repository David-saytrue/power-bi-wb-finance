// Paste each measure: right-click _Fact_Realization → New measure
// (or create empty table "_Measures" and put them there)
// Format % measures: Measure tools → %
// If a column name is red → Data view → rename in formula to match your header

Выручка WB =
CALCULATE (
    SUM ( '_Fact_Realization'[retail_amount] ),
    '_Fact_Realization'[doc_type_name] = "Продажа"
)
    - CALCULATE (
        SUM ( '_Fact_Realization'[retail_amount] ),
        '_Fact_Realization'[doc_type_name] = "Возврат"
    )

Заказы шт =
SUM ( '_Fact_Orders'[Quantity] )

Комиссия WB =
SUM ( '_Fact_Realization'[ppvz_sales_commission] )

База комиссии =
CALCULATE (
    SUM ( '_Fact_Realization'[pricewithdisc] ),
    '_Fact_Realization'[IsStorno] = 0
)

Комиссия WB % =
DIVIDE ( [Комиссия WB], [База комиссии], 0 )

Логистика =
SUM ( '_Fact_Realization'[delivery_rub] )

// Cost via barcode (snowflake → LOOKUPVALUE, not RELATED)
Себестоимость продаж =
SUMX (
    FILTER (
        '_Fact_Realization',
        '_Fact_Realization'[doc_type_name] = "Продажа"
    ),
    VAR Cost =
        LOOKUPVALUE (
            '_Dim-Cost'[Себестоимость],
            '_Dim-Cost'[Штрих-код], '_Fact_Realization'[barcode]
        )
    RETURN
        IF ( ISBLANK ( Cost ), 0, Cost ) * '_Fact_Realization'[quantity]
)

Себестоимость возвратов =
SUMX (
    FILTER (
        '_Fact_Realization',
        '_Fact_Realization'[doc_type_name] = "Возврат"
    ),
    VAR Cost =
        LOOKUPVALUE (
            '_Dim-Cost'[Себестоимость],
            '_Dim-Cost'[Штрих-код], '_Fact_Realization'[barcode]
        )
    RETURN
        IF ( ISBLANK ( Cost ), 0, Cost ) * '_Fact_Realization'[quantity]
)

Валовая прибыль =
[Выручка WB]
    - CALCULATE (
        SUM ( '_Fact_Realization'[ppvz_reward] )
            + SUM ( '_Fact_Realization'[ppvz_vw] )
            + SUM ( '_Fact_Realization'[ppvz_vw_nds] )
            + SUM ( '_Fact_Realization'[delivery_rub] ),
        '_Fact_Realization'[doc_type_name] = "Продажа"
    )
    - CALCULATE (
        SUMX (
            FILTER (
                '_Fact_Realization',
                '_Fact_Realization'[doc_type_name] = "Продажа"
            ),
            DIVIDE (
                '_Fact_Realization'[retail_amount],
                '_Fact_Realization'[quantity],
                0
            ) * 0.02
        )
    )
    - [Себестоимость продаж]
    + CALCULATE (
        SUM ( '_Fact_Realization'[ppvz_reward] )
            + SUM ( '_Fact_Realization'[ppvz_vw] )
            + SUM ( '_Fact_Realization'[ppvz_vw_nds] )
            + SUM ( '_Fact_Realization'[delivery_rub] ),
        '_Fact_Realization'[doc_type_name] = "Возврат"
    )
    + CALCULATE (
        SUMX (
            FILTER (
                '_Fact_Realization',
                '_Fact_Realization'[doc_type_name] = "Возврат"
            ),
            DIVIDE (
                '_Fact_Realization'[retail_amount],
                '_Fact_Realization'[quantity],
                0
            ) * 0.02
        )
    )
    + [Себестоимость возвратов]

Рентабельность =
DIVIDE ( [Валовая прибыль], [Выручка WB], 0 )

ROI =
DIVIDE (
    [Валовая прибыль],
    [Себестоимость продаж] - [Себестоимость возвратов],
    0
)

Выручка пр месяц =
CALCULATE ( [Выручка WB], DATEADD ( 'Dim_Date'[Date], -1, MONTH ) )

Прирост выручки =
[Выручка WB] - [Выручка пр месяц]

Возвраты шт =
CALCULATE (
    SUM ( '_Fact_Realization'[quantity] ),
    '_Fact_Realization'[doc_type_name] = "Возврат"
)

Продажи по областям =
CALCULATE (
    SUM ( '_Fact_Realization'[forpay] ),
    '_Fact_Realization'[isRealization] = 1
)
